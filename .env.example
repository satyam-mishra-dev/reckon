# Reckon configuration. Every variable has a sane default baked into the code
# (apps/api/src/config.ts, apps/worker/src/config.ts) — this file documents
# them; nothing reads .env automatically. docker-compose.yml sets what each
# container needs; export these only when running processes by hand.

# --- shared ------------------------------------------------------------------
DATABASE_URL=postgres://reckon:reckon@localhost:5433/reckon
PROVIDER_URL=http://localhost:4802
LOG_LEVEL=info

# --- api (apps/api) ----------------------------------------------------------
PORT=4800
PROVIDER_TIMEOUT_MS=5000
# Age after which a held idempotency-key lock is presumed dead and taken over.
IDEMPOTENCY_LOCK_TIMEOUT_MS=90000
# Demo-only: exposes GET/PUT /v1/provider/config (an unauthenticated provider
# passthrough). Off by default; compose sets it to 1 for the playground.
ENABLE_PROVIDER_CONFIG=0

# --- worker (apps/worker) ----------------------------------------------------
# WORKER_ID defaults to hostname-pid. The interesting knobs:
BATCH_SIZE=5                 # jobs claimed per poll
HEARTBEAT_MS=5000            # lease heartbeat — keep well below VISIBILITY_MS
VISIBILITY_MS=30000          # locked_at older than this => presumed dead, swept
MAX_ATTEMPTS=10              # then the job/delivery is dead (DLQ)
BACKOFF_BASE_MS=1000         # retry n waits ~ base * 2^(n-1) + jitter
BACKOFF_CAP_MS=60000
COMPLETER_GRACE_MS=30000     # how long a key may sit non-finished before re-driving
COMPLETER_MAX_ATTEMPTS=25    # failed completions before a stuck key is driven terminal (backstop)
RECONCILE_INTERVAL_MS=60000  # cron cadence for reconciliation passes
IDEMPOTENCY_RETENTION_HOURS=72 # finished idempotency keys older than this are reaped
REAP_INTERVAL_MS=3600000     # idempotency-key reaper sweep cadence (default 1h)
WEBHOOK_TIMEOUT_MS=5000
# Liveness file touched every poll; the compose worker healthcheck asserts its mtime.
WORKER_LIVENESS_FILE=/tmp/reckon-worker-alive

# --- provider-sim (apps/provider-sim) ---------------------------------------
# PORT=4802  — failure behavior is runtime config via PUT /config, not env.

# --- receiver (apps/receiver) ------------------------------------------------
# PORT=4803
# The demo receiver verifies signatures with this secret. Compose seeds the
# matching webhook endpoint row via RECKON_WEBHOOK_SECRET (see docker-compose.yml).
WEBHOOK_SECRET=whsec_demo_compose_only

# --- dashboard (apps/dashboard) ----------------------------------------------
# PORT=4801
API_URL=http://localhost:4800
